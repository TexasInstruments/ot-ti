#
#   Applies the patches in third_party/openthread_patches to the openthread submodule.
#   A patch that is already applied is skipped, so the script can be run repeatedly.
#

set -euo pipefail

OT_SRCDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly OT_SRCDIR
readonly OT_SUBMODULE="${OT_SRCDIR}/openthread"
readonly OT_PATCH_DIR="${OT_SRCDIR}/third_party/openthread_patches"

main()
{
    local patch
    local pinned

    pinned="$(git -C "${OT_SUBMODULE}" rev-parse --short HEAD)"

    for patch in "${OT_PATCH_DIR}"/*.patch; do
        [[ -e ${patch} ]] || continue

        if git -C "${OT_SUBMODULE}" apply --reverse --check "${patch}" 2>/dev/null; then
            echo "Already applied: $(basename "${patch}")"
        elif git -C "${OT_SUBMODULE}" apply --check "${patch}" 2>/dev/null; then
            git -C "${OT_SUBMODULE}" apply "${patch}"
            echo "Applied: $(basename "${patch}")"
        else
            echo "Error: $(basename "${patch}") does not apply to openthread ${pinned}." >&2
            echo "The patch was made for a different OpenThread revision or the file was modified." >&2
            echo "Regenerate the patch against openthread ${pinned}." >&2
            exit 1
        fi
    done
}

main "$@"
